// Cloudflare config for the OpenNext build (`npm run cf-build`, `npm run cf-pages`).
// The site is served by Cloudflare Pages (Git-connected); `next build` is unchanged.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "costa-rica",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext's cache layer; must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "costa-rica" }
  ]
  // Runtime env vars (INQUIRY_WEBHOOK_URL, INQUIRY_WEBHOOK_SECRET) live in the Pages project settings.
  // NEXT_PUBLIC_* values are inlined at build time: set them in the build environment.
}
