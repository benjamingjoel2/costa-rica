# Copy to .env.local and fill in. None of these are required to run locally.

# Public URL of the site, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://selvora.tourground.com

# Where inquiries are delivered. The /api/inquiry route POSTs each validated
# inquiry as JSON to this URL (Zapier, Make, Formspree, a CRM webhook, etc.).
# Without it, the form tells visitors honestly that their inquiry was NOT sent.
INQUIRY_WEBHOOK_URL=

# Optional shared secret, sent as "Authorization: Bearer <secret>" to the webhook.
INQUIRY_WEBHOOK_SECRET=

# Optional search engine verification codes (the "content" value of the meta tag
# each tool gives you). Google Search Console: choose the "HTML tag" method.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
